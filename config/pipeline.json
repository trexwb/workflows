{
  "project": {
    "name": "{projectName}",
    "dir": "{projectDir}"
  },
  "projectManager": {
    "enabled": true,
    "agent": "project-manager",
    "promptFile": "prompts/00-project-manager.md",
    "kickoff": true,
    "maxReworkRounds": 2,
    "maxTotalReworks": 6,
    "stateFile": "artifacts/pm-project-state.json",
    "handoffOutput": "artifacts/pm-handoff.md",
    "decisionLog": "artifacts/pm-decisions.md",
    "escalationState": "artifacts/pm-escalation.json",
    "acceptanceOutput": "artifacts/99-acceptance.md"
  },
  "stages": [
    {
      "id": "01-product-plan",
      "name": "产品规划",
      "agent": "product-manager",
      "promptFile": "prompts/01-product-plan.md",
      "input": [
        "artifacts/00-requirement.md"
      ],
      "output": "artifacts/01-prd.md",
      "confirm": true
    },
    {
      "id": "02-requirements",
      "name": "需求拆解",
      "agent": "requirement-analyst",
      "promptFile": "prompts/02-requirements.md",
      "input": [
        "artifacts/01-prd.md"
      ],
      "output": "artifacts/02-tasks.md",
      "confirm": true
    },
    {
      "id": "03-architecture",
      "name": "架构设计",
      "agent": "architect",
      "promptFile": "prompts/03-architecture.md",
      "input": [
        "artifacts/01-prd.md",
        "artifacts/02-tasks.md"
      ],
      "output": "artifacts/03-architecture.md"
    },
    {
      "id": "04-develop",
      "name": "开发编码",
      "agent": "developer",
      "promptFile": "prompts/04-develop.md",
      "input": [
        "artifacts/02-tasks.md",
        "artifacts/03-architecture.md"
      ],
      "output": "artifacts/04-implementation.md"
    },
    {
      "id": "05-code-review",
      "name": "代码审查",
      "agent": "code-reviewer",
      "promptFile": "prompts/05-code-review.md",
      "input": [
        "artifacts/03-architecture.md"
      ],
      "output": "artifacts/05-review.md"
    },
    {
      "id": "06-test",
      "name": "测试",
      "agent": "tester",
      "promptFile": "prompts/06-test.md",
      "input": [
        "artifacts/02-tasks.md",
        "artifacts/05-review.md"
      ],
      "output": "artifacts/06-test-report.md"
    },
    {
      "id": "07-deploy",
      "name": "部署",
      "agent": "devops",
      "promptFile": "prompts/07-deploy.md",
      "input": [
        "artifacts/05-review.md",
        "artifacts/06-test-report.md"
      ],
      "output": "artifacts/07-deploy.md"
    }
  ],
  "_comment": "阶段字段：id/name/agent（对应 agents.json 键）、promptFile（相对 skill 根）、input（前序产物路径列表，缺失仅告警）、output（产物落盘路径，null=不落盘）、model/fallbackModels 可在阶段级覆盖。projectManager 默认启用：项目经理负责派活与逐阶段验收，confirm 字段仅在旧配置回退模式用于人工确认。"
}